        }
      ],
      "translation": "济水发源于共山南面的东丘，穿过巨野泽，流经齐地琅槐的东北入渤海。",
      "index": 23
    },
    {
      "title": "潦水",
      "originalText": "潦水出卫皋东，东南注渤海，入潦阳。",
      "annotations": [
        {
          "term": "潦水",
          "explanation": "即辽河，中国东北地区南部大河，流贯辽宁省中部，经盘锦市入渤海"
        },
        {
          "term": "卫皋(ɡāo)",
          "explanation": "山名，具体所指待考"
        },
        {
          "term": "潦阳",
          "explanation": "即辽阳，古县名，在今辽宁辽中县"
        }
      ],
      "translation": "潦水发源于卫皋的东面，向东南流经潦阳入渤海。",
      "index": 24
    },
    {
      "title": "虖沱河",
      "originalText": "虖沱水出晋阳城南，而西至阳曲北，而东注渤海，入越章武北。",
      "annotations": [
        {
          "term": "晋阳",
          "explanation": "古县名，在今山西太原市"
        },
        {
          "term": "阳曲",
          "explanation": "古县名，在今山西太原市北部，包括定襄县、阳曲县等"
        },
        {
          "term": "越",
          "explanation": "一说疑为衍文；一说应作“赵”；一说章武在春秋时属越，故有此说"
        },
        {
          "term": "章武",
          "explanation": "古县名，汉置，治今河北黄骅(huá)市西北"
        }
      ],
      "translation": "虖沱河发源于晋阳城的南边，西流至阳曲县的北边，再向东流经章武的北边入渤海。",
      "index": 25
    },
    {
      "title": "漳水",
      "originalText": "漳水出山阳东，东注渤海，入章武南。",
      "annotations": [
        {
          "term": "山阳",
          "explanation": "一说在河南修武县；一说疑为“阳邑(yì)”之讹，阳邑是古县名，在今山西榆次市南边"
        }
      ],
      "translation": "漳河发源于山阳的东面，向东流经章武的南边入渤海。",
      "index": 26
    }
  ],
